(parser_headers) {
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "accelerometer=(), autoplay=(), bluetooth=(), browsing-topics=(), camera=(), clipboard-read=(), clipboard-write=(), display-capture=(), encrypted-media=(), fullscreen=(), gamepad=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), local-fonts=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-create=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), storage-access=(), usb=(), xr-spatial-tracking=()"
		-Server
		-Set-Cookie
	}
}

(parser_page) {
	@page not path /_app/immutable/workers/*
	import /etc/caddy/csp.caddy
}

:80 {
	root * /srv

	import parser_headers

	@write not method GET HEAD
	respond @write 405

	@serviceworker header Service-Worker *
	respond @serviceworker 403

	@worker path /_app/immutable/workers/*
	header @worker Content-Security-Policy "default-src 'none'; connect-src 'none'; worker-src 'none'; script-src 'wasm-unsafe-eval'"

	import parser_page

	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@mutable not path /_app/immutable/*
	header @mutable Cache-Control "no-cache"

	@spa {
		not file
		not path_regexp \.
	}
	rewrite @spa /index.html
	file_server
	encode zstd gzip

	handle_errors 404 {
		import parser_headers
		header Cache-Control "no-store"
		respond 404
	}
}
