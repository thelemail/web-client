{
  "name": "@thelemail/auth",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "rm -rf build-meta && vite build && node ../../scripts/auth-headers.ts",
    "preview": "vite preview",
    "prepare": "pnpm i18n:compile && svelte-kit sync || echo ''",
    "check": "pnpm i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "pnpm i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:bundle": "node ../../scripts/check-build-origins.mjs && node ../../scripts/check-auth-bundle.mjs",
    "i18n:compile": "node ../../scripts/i18n-compile.ts"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.4",
    "@lucide/svelte": "^1.39.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "jsdom": "^29.1.1",
    "shadcn-svelte": "^1.3.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@protontech/crypto": "^2.0.1",
    "@scure/bip39": "^2.2.0",
    "@serenity-kit/opaque": "1.1.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@thelemail/core": "workspace:*",
    "hash-wasm": "^4.12.0",
    "openpgp": "^6.3.0"
  }
}
